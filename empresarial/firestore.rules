rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // equipos: nombre y fecha de alta.
    // miembros: nombre, equipo, departamento, puesto y estado.
    // expedientes: equipo, fase, asignación, participantes, revisión y partes.
    // expedientes/{id}/historial: cambios confirmados con actor y fecha.
    // bandejas/{uid}/avisos: entregas por destinatario y lectura.
    // miembros/{uid}/operaciones: recibos por usuario y operación.
    // control y auditoria: arranque de Dirección y altas de organización.
    // La API autenticada controla los datos. El cliente observa solo el sello
    // actualizado (timestamp sin datos del expediente) de su propio equipo.
    function miembroActivoDe(equipoId) {
      let perfil = get(/databases/$(database)/documents/miembros/$(request.auth.uid)).data;
      return perfil.activo == true && perfil.equipoId == equipoId;
    }
    match /equipos/{equipoId}/senales/actividad {
      allow get: if request.auth != null && miembroActivoDe(equipoId);
    }
    match /{path=**} {
      allow read, write: if false;
    }
  }
}

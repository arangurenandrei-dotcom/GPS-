{
  "functions": {
    "source": ".",
    "codebase": "empresarial",
    "runtime": "nodejs22",
    "ignore": ["node_modules", "client", "public", "dist", "scripts", "test", ".*", "firebase-pruebas.local.json", "*-debug.log"],
    "predeploy": "node scripts/validar-destino.cjs"
  },
  "firestore": {
    "rules": "firestore.rules", "indexes": "firestore.indexes.json",
    "predeploy": "node scripts/validar-destino.cjs"
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "predeploy": ["node scripts/validar-destino.cjs", "node scripts/compilar.cjs --staging"]
  },
  "emulators": {
    "singleProjectMode": true,
    "auth": { "host": "127.0.0.1", "port": 9109 },
    "firestore": { "host": "127.0.0.1", "port": 8183 },
    "functions": { "host": "127.0.0.1", "port": 5003 },
    "hosting": { "host": "127.0.0.1", "port": 5004 },
    "hub": { "host": "127.0.0.1", "port": 4401 },
    "logging": { "host": "127.0.0.1", "port": 4501 },
    "ui": { "enabled": false }
  }
}
